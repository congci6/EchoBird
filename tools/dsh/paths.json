{
    "name": "DeepSeek Harness",
    "category": "Desktop",
    "noCwdPrompt": true,
    "apiProtocol": [
        "anthropic",
        "openai"
    ],
    "docs": "https://deepseek-harness.github.io/deepseek-harness/",
    "website": "https://www.deepseek.com/harness/",
    "description": "Official DeepSeek Harness desktop app. Apply & Launch restarts the app to load the selected model for new sessions.",
    "command": "",
    "configDir": "~/.dsh",
    "configFile": "~/.dsh/profiles/desktop/cordis.patch.yml",
    "requireConfigFile": false,
    "paths": {
        "win32": [
            "%LOCALAPPDATA%\\Programs\\DeepSeek Harness\\DeepSeek Harness.exe"
        ],
        "darwin": [
            "/Applications/DeepSeek Harness.app/Contents/MacOS/DeepSeek Harness",
            "~/Applications/DeepSeek Harness.app/Contents/MacOS/DeepSeek Harness"
        ],
        "linux": []
    },
    "installHints": {
        "windowsDisplayNamePrefixes": ["DeepSeek Harness"],
        "macosAppName": "DeepSeek Harness"
    }
}
